---
/**
 * v5 – treść i kolejność z v2, wygląd z v3.
 * 1. Różowy pas 1:1 jak v3 (pigułka, termin, tytuł, opis, przycisk) – formularz w oknie dialogowym.
 * 2. W miejscu zdjęcia z v3: karta z podsumowaniem webinaru + prowadząca, na granicy pasów z paskiem gradientu.
 * 3. „Czujesz, że…”  4. Struktura JA / MOŻLIWOŚCI / WYBÓR  5. Opinie (jak v2)
 * 6. FAQ  7. Licznik i przycisk do formularza  8. Stopka.
 */
import '../../styles/v5.css';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import DuringBanner from '../../components/DuringBanner.astro';
import HostPhoto from '../../components/HostPhoto.astro';
import FormDialog from '../../components/v3/FormDialog.astro';
import Footer from '../../components/v3/Footer.astro';
import StickyCta from '../../components/StickyCta.astro';
import ConsentBanner from '../../components/ConsentBanner.astro';
import { copy } from '../../config/copy';
import { copyV2 } from '../../config/copy.v2';
import { copyV5 } from '../../config/copy.v5';
import { eventConfig } from '../../config/event.config';
import { parseSessions } from '../../lib/eventState';
import { formatDate, formatTime } from '../../lib/format';

const [first] = parseSessions(eventConfig.sessions);
const NBSP = '\u00a0';
// „3 grudnia 2026” z twardymi spacjami – data nigdy nie łamie się między wierszami.
const longDate = formatDate(first.start).replace(/ /g, NBSP);
const weekday = new Intl.DateTimeFormat('pl-PL', { weekday: 'long', timeZone: 'Europe/Warsaw' }).format(first.start);
const time = formatTime(first.start);
const minutes = Math.round((first.end - first.start) / 60000);
const iso = new Date(first.start).toISOString();
const [quote, ...moreQuotes] = copy.testimonials.items;
const description = `${copyV5.hero.description}`;
---

<Base title={`${copyV5.hero.headline} | Bezpłatny webinar – Przystań Zmiany Zawodowej`} description={description} path="v5/">
  <Header version="v5" centered />
  <DuringBanner />
  <main id="main">
    <!-- 1. HERO – kompozycja i proporcje 1:1 jak v3 -->
    <section class="band hero5" aria-labelledby="hero-title">
      <div class="container hero5__inner">
        <p class="pill">Webinar</p>
        <p class="hero5__over" data-show="before during">
          <time datetime={iso}>{longDate}</time> · {time} · {minutes}{NBSP}min · online
        </p>
        <p class="hero5__over" data-show="after">Nagranie · bez limitu czasu</p>
        <h1 id="hero-title">
          <span data-show="before during">{copyV5.hero.headline}</span>
          <span data-show="after">{copyV5.hero.afterHeadline}</span>
        </h1>
        <p class="hero5__sub" data-show="before during">{copyV5.hero.description}</p>
        <p class="hero5__sub" data-show="after">{copyV5.hero.afterDescription}</p>
        <button type="button" class="btn btn--white hero5__cta" data-open-form="hero" data-sticky-anchor>
          <span data-show="before during">{copyV5.form.submit}</span>
          <span data-show="after">{copyV5.form.submitAfter}</span>
        </button>
      </div>
    </section>

    <!-- 2. W miejscu zdjęcia z v3: podsumowanie webinaru na granicy pasów (+ pasek gradientu) -->
    <section class="frame5" aria-label="Szczegóły webinaru i prowadząca">
      <div class="frame5__stripe stripe" aria-hidden="true"></div>
      <div class="container frame5__box">
<div class="event5__card">
          <ul class="event5__facts" role="list">
            <li data-show="before during">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
              <span><time datetime={iso}>{longDate}</time>, {weekday}, {time}</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
              <span>{copyV5.facts.online}</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l5 5v15H6z"></path><path d="M14 2v6h6M9 13h8M9 17h6"></path></svg>
              <span>{copyV5.facts.worksheet}</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M10 9l5 3-5 3z"></path></svg>
              <span>{copyV5.facts.recording}</span>
            </li>
          </ul>
          <div class="event5__host">
            <HostPhoto crop="square" sizes="88px" class="event5__photo" position="50% 40%" />
            <p>{copyV5.host}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Czujesz, że… -->
    <section class="section pains5" aria-labelledby="pains-title">
      <div class="container pains5__inner">
        <h2 id="pains-title" class="center">{copyV5.pains.heading}</h2>
        <ul class="pains5__list" role="list">
          {copyV5.pains.items.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- 4. Struktura JA / MOŻLIWOŚCI / WYBÓR -->
    <section class="section section--blush struct5" aria-labelledby="struct-title">
      <div class="container">
        <h2 id="struct-title" class="visually-hidden">Struktura, którą poznasz na webinarze</h2>
        <p class="struct5__intro">{copyV5.structure.intro}</p>
        <ol class="struct5__steps" role="list">
          {
            copyV5.structure.steps.map((s) => (
              <li>
                <span class="struct5__num" aria-hidden="true">{s.num}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="struct5__closing">{copyV5.structure.closing}</p>
      </div>
    </section>

    <!-- 5. Opinie – jak w v2 -->
    <section class="section quotes5" aria-labelledby="quotes-title">
      <div class="container">
        <div class="quotes5__card">
          <h2 class="visually-hidden" id="quotes-title">{copyV2.testimonials.heading}</h2>
          <svg class="quotes5__icon" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm18 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z"></path></svg>
          <figure>
            <blockquote><p>{quote.quote}</p></blockquote>
            <figcaption><strong>{quote.author}</strong>, {quote.role}</figcaption>
          </figure>
          <details class="more quotes5__more">
            <summary>{copyV2.testimonials.moreSummary}</summary>
            <div class="more__body">
              {
                moreQuotes.map((t) => (
                  <figure class="quotes5__extra">
                    <blockquote><p>{t.quote}</p></blockquote>
                    <figcaption><strong>{t.author}</strong>, {t.role}</figcaption>
                  </figure>
                ))
              }
            </div>
          </details>
          <p class="quotes5__note">{copy.testimonials.note}</p>
        </div>
      </div>
    </section>

    <!-- 6. FAQ -->
    <section class="section faq5" aria-labelledby="faq-title">
      <div class="container faq5__inner">
        <h2 id="faq-title" class="center">{copyV5.faq.heading}</h2>
        {
          copyV5.faq.items.map((item) => (
            <details class="more">
              <summary>{item.q}</summary>
              <div class="more__body">
                <p>{item.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <!-- 7. Licznik i powrót do formularza (pas jak w v3) -->
    <section class="band final5" aria-labelledby="final-title" data-sticky-hide>
      <div class="container final5__inner">
        <h2 id="final-title">
          <span data-show="before">{copyV5.final.before}</span>
          <span data-show="during">{copyV5.final.during}</span>
          <span data-show="after">{copyV5.final.after}</span>
        </h2>
        <div data-show="before" data-countdown>
          <p class="final5__date">Start: <time datetime={iso}>{longDate}, {weekday}, {time}</time></p>
          <div class="final5__grid" aria-hidden="true">
            <div><span data-unit="days">–</span><small data-label="days">dni</small></div>
            <div><span data-unit="hours">–</span><small data-label="hours">godz.</small></div>
            <div><span data-unit="minutes">–</span><small data-label="minutes">min</small></div>
            <div><span data-unit="seconds">–</span><small data-label="seconds">sek.</small></div>
          </div>
        </div>
        <button type="button" class="btn btn--white" data-open-form="final">
          <span data-show="before">{copyV5.final.cta.before}</span>
          <span data-show="during">{copyV5.final.cta.during}</span>
          <span data-show="after">{copyV5.final.cta.after}</span>
        </button>
      </div>
    </section>
  </main>
  <Footer />
  <FormDialog thanks="v5/dziekuje/" withName lead="Podaj imię i e-mail – wyślę Ci link do spotkania i przypomnienie." />
  <StickyCta />
  <ConsentBanner defer />
  <script>
    import '../../scripts/landing';
  </script>
</Base>

<style>
  /* 1. HERO – wartości 1:1 z v3 (.hero3) */
  .hero5 {
    padding-block: 40px 140px;
  }
  .hero5__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .pill {
    margin: 0 0 18px;
    padding: 4px 18px;
    border: 2px solid var(--white);
    border-radius: 999px;
    font: 600 0.75rem/1.5 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero5__over {
    margin: 0 0 10px;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero5 h1 {
    max-width: 22ch;
    margin-bottom: 14px;
    font-size: clamp(1.875rem, 1.2rem + 3vw, 3.5rem);
    line-height: 1.08;
  }
  .hero5__sub {
    max-width: 44ch;
    margin-bottom: 26px;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
  }
  .hero5__cta {
    min-width: min(100%, 320px);
  }

  /* 2. PODSUMOWANIE W MIEJSCU ZDJĘCIA (pozycja i cień jak ramka v3) */
  .frame5 {
    position: relative;
    margin-top: -110px;
  }
  .frame5__stripe {
    position: absolute;
    inset-inline: 0;
    top: 110px;
  }
  .frame5__box {
    position: relative;
  }
  .event5__card {
    max-width: 760px;
    margin: 0 auto;
    padding: 24px;
    border-radius: 6px;
    background: var(--white);
    box-shadow: 0 30px 60px -24px rgb(43 8 26 / 0.45);
  }
  .event5__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px 16px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
  }
  .event5__facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .event5__facts svg {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--pink-700);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .event5__host {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--blush-100);
  }
  .event5__host p {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .event5 :global(.event5__photo),
  .frame5 :global(.event5__photo) {
    flex: none;
    width: 76px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--pink-200);
  }

  /* 3. CZUJESZ, ŻE… */
  .pains5__inner {
    max-width: 820px;
  }
  .pains5 h2 {
    max-width: 24ch;
    margin-inline: auto;
  }
  .pains5__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .pains5__list li {
    position: relative;
    padding: 16px 18px 16px 52px;
    border-radius: 6px;
    background: var(--blush-50);
    color: var(--ink);
  }
  .pains5__list li::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 3px solid var(--pink-700);
    transform: translateY(-50%);
  }

  /* 4. STRUKTURA */
  .struct5__intro {
    max-width: 52ch;
    margin: 0 auto 40px;
    text-align: center;
    font: 500 clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem) / 1.35 var(--font-heading);
    color: var(--ink);
  }
  .struct5__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .struct5__steps li {
    padding: 28px 24px;
    border-radius: 6px;
    background: var(--white);
    box-shadow: 0 20px 40px -24px rgb(43 8 26 / 0.3);
    border-top: 6px solid var(--pink-700);
  }
  .struct5__num {
    display: block;
    margin-bottom: 6px;
    font: 500 2.75rem/1 var(--font-heading);
    color: var(--pink-600);
  }
  .struct5__steps h3 {
    margin-bottom: 8px;
    font-size: 1.5rem;
    color: var(--ink);
  }
  .struct5__steps p {
    margin: 0;
  }
  .struct5__closing {
    max-width: 56ch;
    margin: 36px auto 0;
    text-align: center;
    font-weight: 600;
    color: var(--ink);
  }

  /* 5. OPINIE (jak v2) */
  .quotes5__card {
    max-width: 760px;
    margin-inline: auto;
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: var(--radius);
    background: var(--pink-700);
    color: var(--white);
  }
  .quotes5__icon {
    width: 32px;
    height: 24px;
    margin-bottom: 12px;
    fill: var(--pink-200);
  }
  .quotes5__card figure,
  .quotes5__card blockquote {
    margin: 0;
  }
  .quotes5__card blockquote p {
    margin-bottom: 10px;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .quotes5__card figcaption {
    font-size: 0.875rem;
  }
  .quotes5__more {
    margin-top: 16px;
    border-top-color: rgb(255 255 255 / 0.4);
  }
  .quotes5__more > summary {
    color: var(--white);
  }
  .quotes5__extra {
    margin-bottom: 16px !important;
  }
  .quotes5__note {
    margin: 12px 0 0;
    font-size: 0.75rem;
  }
  .quotes5__card :focus-visible {
    box-shadow: 0 0 0 3px var(--white);
  }

  /* 6. FAQ */
  .faq5 {
    padding-top: 0;
  }
  .faq5__inner {
    max-width: 820px;
  }
  .faq5 .more:last-of-type {
    border-bottom: 1px solid var(--pink-200);
  }

  /* 7. KOŃCOWY PAS */
  .final5 {
    padding-block: clamp(56px, 7vw, 88px);
  }
  .final5__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .final5 h2 {
    font-size: clamp(1.75rem, 1.3rem + 2vw, 2.75rem);
    margin-bottom: 12px;
  }
  .final5__date {
    margin-bottom: 12px;
    font-weight: 600;
  }
  .final5__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(64px, 88px));
    gap: 8px;
    margin-bottom: 24px;
  }
  .final5__grid div {
    display: grid;
    padding: 10px 4px;
    border-radius: 4px;
    background: var(--pink-800); /* ciemniejszy kafelek: biały tekst 8:1 (jasny dawał 4,18:1) */
  }
  .final5__grid span {
    font: 500 clamp(1.5rem, 1.2rem + 1.2vw, 2rem) / 1.1 var(--font-heading);
    font-variant-numeric: tabular-nums;
  }
  .final5__grid small {
    font-size: 0.75rem;
  }

  @media (min-width: 768px) {
    .event5__facts {
      grid-template-columns: repeat(4, auto);
      justify-content: space-between;
    }
    .event5__card {
      padding: 28px 36px;
    }
    .struct5__steps {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .hero5 {
      padding-block: 64px 180px;
    }
    .frame5 {
      margin-top: -150px;
    }
    .frame5__stripe {
      top: 150px;
    }
    .event5__card {
      padding: 32px 40px;
    }
  }
</style>
