---
import { copyV2 } from '../../config/copy.v2';
import { copy } from '../../config/copy';
import type { ParsedSession } from '../../lib/eventState';
import { formatDate, formatTime, formatTimeRange } from '../../lib/format';
import SignupForm from './SignupForm.astro';

interface Props {
  session: ParsedSession;
}
const { session } = Astro.props;
const h = copyV2.hero;
const date = formatDate(session.start);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__main">
      <p class="eyebrow" data-show="before during">
        {h.eyebrowPrefix} · <span class="nowrap">{date}</span> · <span class="nowrap">{formatTime(session.start)}</span>
      </p>
      <p class="eyebrow" data-show="after">{copyV2.after.eyebrow}</p>

      <h1 id="hero-title">
        <span data-show="before during">
          <span data-variant-show="A">{h.headline.A}</span>
          <span data-variant-show="B">{h.headline.B}</span>
        </span>
        <span data-show="after">{copyV2.after.headline}</span>
      </h1>

      <p class="hero__sub" data-show="before during">{h.subtitle}</p>
      <p class="hero__sub" data-show="after">{copyV2.after.subtitle}</p>

      <SignupForm />
    </div>

    <!-- Karta wydarzenia: konkrety na różowym tle + małe zdjęcie prowadzącej zamiast dużego portretu. -->
    <aside class="event" aria-label="Szczegóły webinaru">
      <ul class="event__facts" role="list">
        <li data-show="before during">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
          <span><strong><time datetime={new Date(session.start).toISOString()}>{date}</time></strong><br />{formatTimeRange(session)}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          <span><strong>{h.facts.online}</strong></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12v8H4v-8M2 7h20v5H2zM12 22V7M12 7c-2-4-6-4-6-1s6 1 6 1 6 2 6-1-4-3-6 1"></path></svg>
          <span><strong>{h.facts.free}</strong></span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"></rect><path d="M10 9l5 3-5 3z"></path></svg>
          <span><strong>{h.facts.recording}</strong></span>
        </li>
      </ul>

      <div class="event__host">
        <!-- TODO: okrągłe zdjęcie Agnieszki 96×96 (AVIF/WebP) – teraz zamiennik. -->
        <span class="event__photo" role="img" aria-label={copy.host.photoPlaceholder}>AB</span>
        <p>{h.host}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  /* Telefon: zwarty górny ekran, żeby przycisk zapisu był widoczny nad banerem cookies. */
  .hero {
    padding-block: 16px 48px;
    background: linear-gradient(180deg, var(--white) 0%, var(--white) 65%, var(--blush-50) 100%);
    border-bottom: 10px solid var(--pink-600); /* różowy pas pod hero jak na stronie-matce */
  }
  .hero__grid {
    display: grid;
    gap: 40px;
  }
  .eyebrow {
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(1.75rem, 1.1rem + 2.6vw, 3.25rem);
    line-height: 1.1;
    margin-bottom: 14px;
  }
  .hero__sub {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--graphite);
    max-width: 48ch;
    margin-bottom: 18px;
  }

  .event {
    align-self: start;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--pink-700);
    color: var(--white);
  }
  .event__facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px 16px;
    font-size: 0.9375rem;
    line-height: 1.4;
  }
  .event__facts li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .event__facts strong {
    font-weight: 600;
  }
  .event__facts svg {
    flex: none;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    fill: none;
    stroke: var(--white);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .event__host {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }
  .event__host p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .event__photo {
    flex: none;
    display: grid;
    place-items: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 3px solid var(--white);
    background: var(--blush-100);
    color: var(--pink-800);
    font: 500 1.25rem/1 var(--font-heading);
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: 72px 88px;
    }
    .eyebrow {
      margin-bottom: 16px;
    }
    h1 {
      margin-bottom: 20px;
    }
    .hero__sub {
      margin-bottom: 28px;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
      gap: 80px;
      align-items: center;
    }
    .event {
      padding: 36px;
    }
    .event__facts {
      grid-template-columns: 1fr;
      gap: 22px;
      font-size: 1rem;
    }
    .event__photo {
      width: 88px;
      height: 88px;
    }
  }
</style>
