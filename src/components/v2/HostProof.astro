---
import { copy } from '../../config/copy';
import { copyV2 } from '../../config/copy.v2';
import HostPhoto from '../HostPhoto.astro';

const h = copyV2.host;
const [first, ...rest] = copy.testimonials.items;
---

<section class="section section--blush" aria-labelledby="host-title">
  <div class="container hp-grid">
    <div class="host">
      <div class="host__photo">
        <HostPhoto crop="square" sizes="160px" />
      </div>
      <div>
        <h2 id="host-title">{h.heading}</h2>
        <p class="host__name">{copy.host.name}</p>
        <p>{h.lead}</p>
        <details class="more">
          <summary>{h.moreSummary}</summary>
          <div class="more__body">{h.more.map((t) => <p>{t}</p>)}</div>
        </details>
      </div>
    </div>

    <section class="quote" aria-labelledby="quotes-title">
      <h2 class="visually-hidden" id="quotes-title">{copyV2.testimonials.heading}</h2>
      <svg class="quote__icon" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4 1 12 0l1 4c-4 1-6 4-6 8h6v12zm18 0V14c0-8 4-13 12-14l1 4c-4 1-6 4-6 8h6v12z"></path></svg>
      <figure class="quote__main">
        <blockquote><p>{first.quote}</p></blockquote>
        <figcaption><strong>{first.author}</strong>, {first.role}</figcaption>
      </figure>
      <details class="more quote__more">
        <summary>{copyV2.testimonials.moreSummary}</summary>
        <div class="more__body">
          {
            rest.map((t) => (
              <figure class="quote__extra">
                <blockquote><p>{t.quote}</p></blockquote>
                <figcaption><strong>{t.author}</strong>, {t.role}</figcaption>
              </figure>
            ))
          }
        </div>
      </details>
      <p class="quote__note">{copy.testimonials.note}</p>
    </section>
  </div>
</section>

<style>
  .hp-grid {
    display: grid;
    gap: 48px;
  }
  .host {
    display: grid;
    gap: 20px;
  }
  .host__photo {
    width: 140px;
  }
  .host__photo :global(.photo-ph) {
    border-radius: var(--radius-lg);
  }
  .host__name {
    margin-bottom: 6px;
    font: 500 1.25rem/1.3 var(--font-heading);
    color: var(--pink-800);
  }
  .quote {
    margin: 0;
    padding: clamp(28px, 3.5vw, 44px);
    border-radius: var(--radius);
    background: var(--pink-700);
    color: var(--white);
  }
  .quote__icon {
    width: 32px;
    height: 24px;
    margin-bottom: 12px;
    fill: var(--pink-200);
  }
  .quote figure,
  .quote blockquote {
    margin: 0;
  }
  .quote blockquote p {
    font-size: 1.0625rem;
    line-height: 1.55;
    margin-bottom: 10px;
  }
  .quote figcaption {
    font-size: 0.875rem;
  }
  .quote__more {
    margin-top: 16px;
    border-top-color: rgb(255 255 255 / 0.4);
  }
  .quote__more > summary {
    color: var(--white);
  }
  .quote__extra {
    margin: 0 0 16px;
  }
  .quote__extra blockquote p {
    font-size: 0.9375rem;
  }
  .quote__note {
    margin: 12px 0 0;
    font-size: 0.75rem;
    color: var(--white);
  }
  .quote :focus-visible {
    box-shadow: 0 0 0 3px var(--white);
  }
  @media (min-width: 768px) {
    .host {
      grid-template-columns: 160px 1fr;
      align-items: start;
    }
    .host__photo {
      width: 160px;
    }
  }
  @media (min-width: 1024px) {
    .hp-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 96px;
      align-items: start;
    }
  }
</style>
