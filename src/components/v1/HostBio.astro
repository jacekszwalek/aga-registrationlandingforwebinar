---
import { copy } from '../../config/copy';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';
const c = copy.host;
---

<section class="section" aria-labelledby="host-title">
  <div class="container host">
    <div class="host__media">
      <PhotoPlaceholder label={c.photoPlaceholder} ratio="1 / 1" />
    </div>
    <div>
      <h2 id="host-title">{c.heading}</h2>
      <p class="host__name">{c.name}</p>
      <p class="host__role">{c.role}</p>
      {c.paragraphs.map((t) => <p>{t}</p>)}
    </div>
  </div>
</section>

<style>
  .host {
    display: grid;
    gap: 24px;
    align-items: center;
  }
  .host__media {
    max-width: 280px;
  }
  .host__name {
    margin: 0;
    font: 500 1.375rem/1.3 var(--font-heading);
    color: var(--pink-800);
  }
  .host__role {
    font-weight: 600;
    color: var(--ink);
  }
  @media (min-width: 768px) {
    .host {
      grid-template-columns: 220px 1fr;
      gap: 48px;
    }
    .host__media {
      max-width: none;
    }
  }
</style>
