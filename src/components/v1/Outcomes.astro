---
import { copy } from '../../config/copy';
const c = copy.outcomes;
---

<section class="section section--blush" aria-labelledby="outcomes-title">
  <div class="container">
    <h2 id="outcomes-title">{c.heading}</h2>
    <ol class="outcomes" role="list">
      {
        c.items.map((item, i) => (
          <li class="card outcomes__item">
            <span class="outcomes__num" aria-hidden="true">{i + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <p class="outcomes__result">
              <strong>Twój rezultat:</strong> {item.result}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .outcomes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .outcomes__item {
    display: flex;
    flex-direction: column;
  }
  .outcomes__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 12px;
    border-radius: 50%;
    background: var(--pink-700);
    color: var(--white);
    font: 500 1.25rem/1 var(--font-heading);
  }
  .outcomes__item p {
    color: var(--text-muted);
  }
  .outcomes__result {
    margin: auto 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--blush-100);
    color: var(--ink) !important;
  }
  .outcomes__result strong {
    color: var(--pink-800);
  }
  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
</style>
