---
import { copy } from '../../config/copy';
import SignupForm from './SignupForm.astro';
import PhotoPlaceholder from '../PhotoPlaceholder.astro';

interface Props {
  overline: string[];
}
const { overline } = Astro.props;
const h = copy.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow" data-show="before during">
        {overline.map((part, i) => (<>{i > 0 && ' · '}<span class="nowrap">{part}</span></>))}
      </p>
      <p class="eyebrow" data-show="after">{copy.after.overline}</p>

      <h1 id="hero-title">
        <span data-show="before during">
          <span data-variant-show="A">{h.headline.A}</span>
          <span data-variant-show="B">{h.headline.B}</span>
        </span>
        <span data-show="after">{copy.after.headline}</span>
      </h1>

      <p class="hero__sub" data-show="before during">{h.subtitle}</p>
      <p class="hero__sub" data-show="after">{copy.after.subtitle}</p>
    </div>

    <div class="hero__media">
      <PhotoPlaceholder label={copy.host.photoPlaceholder} ratio="4 / 5" />
    </div>

    <div class="hero__form card">
      <SignupForm id="hero" />
    </div>

    <p class="hero__host">{h.host}</p>
  </div>
</section>

<style>
  .hero {
    background:
      radial-gradient(90% 60% at 100% 0%, var(--blush-100) 0%, transparent 70%),
      var(--blush-50);
    padding-block: 20px 40px;
  }
  .hero__grid {
    display: grid;
    gap: 16px;
    grid-template-areas: 'text' 'media' 'form' 'host';
  }
  .hero__text {
    grid-area: text;
  }
  .hero__media {
    grid-area: media;
  }
  .hero__form {
    grid-area: form;
  }
  .hero__host {
    grid-area: host;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .eyebrow {
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(1.75rem, 1.2rem + 2.6vw, 3.25rem);
    margin-bottom: 12px;
  }
  .hero__sub {
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    color: var(--text);
    margin: 0;
  }

  /* Mobile: krótki, szeroki kadr zdjęcia, żeby przycisk był najwyżej jedno przewinięcie niżej. */
  @media (max-width: 1023.98px) {
    .hero__media :global(.photo-ph) {
      aspect-ratio: 2 / 1 !important;
      max-height: 26dvh;
    }
  }

  /* Desktop: dwie kolumny – tekst i formularz | zdjęcie. */
  @media (min-width: 1024px) {
    .hero {
      padding-block: 40px 56px;
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      grid-template-areas:
        'text media'
        'form media'
        'form host';
      grid-template-rows: auto auto 1fr;
      column-gap: 56px;
      row-gap: 20px;
      align-items: start;
    }
    .hero__media :global(.photo-ph) {
      max-height: calc(100dvh - 240px);
    }
    .hero__host {
      align-self: start;
    }
    .hero__form :global(.signup-form) {
      grid-template-columns: 1fr 1fr;
      column-gap: 14px;
    }
    .hero__form :global(.signup-form > :not(.field)) {
      grid-column: 1 / -1;
    }
  }
</style>
