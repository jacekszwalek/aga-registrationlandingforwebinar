---
/**
 * Zamiennik zdjęcia Agnieszki na czas prototypu. Ma stałe proporcje (zero CLS),
 * więc podmiana na <Picture> z AVIF/WebP nie zmieni układu.
 */
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}
const { label, ratio = '4 / 5', class: className } = Astro.props;
---

<div class:list={['photo-ph', className]} style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
  <svg viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <circle cx="100" cy="78" r="36" fill="#ffffff" fill-opacity="0.75"></circle>
    <path d="M36 200c4-46 30-74 64-74s60 28 64 74z" fill="#ffffff" fill-opacity="0.75"></path>
  </svg>
  <span class="photo-ph__label">{label}</span>
</div>

<style>
  .photo-ph {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 80% at 80% 10%, var(--white) 0%, transparent 60%),
      linear-gradient(160deg, var(--pink-200), var(--blush-100));
    box-shadow: inset 0 0 0 1px var(--pink-200), var(--shadow);
  }
  .photo-ph svg {
    position: absolute;
    bottom: 0;
    width: min(70%, 320px);
    height: auto;
  }
  .photo-ph__label {
    position: absolute;
    top: 12px;
    left: 12px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #4a3b00;
    background: #fff6c2;
    border-radius: 6px;
    padding: 2px 8px;
  }
</style>
