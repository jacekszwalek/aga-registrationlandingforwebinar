---
import { copy } from '../config/copy';
import { eventConfig } from '../config/event.config';
const c = copy.consent;
---

<section class="consent" data-consent-banner aria-label="Zgoda na pliki cookies" hidden>
  <div class="consent__inner">
    <p>
      {c.text} <a href={eventConfig.site.privacyPolicyUrl} rel="noopener">{c.policy}</a>
    </p>
    <div class="consent__actions">
      <!-- Obie opcje równie widoczne. -->
      <button type="button" class="btn btn--ghost" data-consent="denied">{c.reject}</button>
      <button type="button" class="btn" data-consent="granted">{c.accept}</button>
    </div>
  </div>
</section>

<style>
  .consent {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 50;
    background: var(--white);
    border-top: 2px solid var(--pink-200);
    box-shadow: 0 -10px 30px -12px rgb(43 8 26 / 0.3);
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
  }
  .consent[hidden] {
    display: none;
  }
  .consent__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    display: grid;
    gap: 8px;
  }
  p {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--text);
  }
  .consent__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .consent .btn {
    min-height: 44px;
    padding: 8px 16px;
    font-size: 0.9375rem;
    box-shadow: none;
  }
  .consent .btn--ghost {
    box-shadow: inset 0 0 0 2px var(--pink-700);
  }
  @media (min-width: 768px) {
    .consent__inner {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 24px;
    }
    .consent__actions {
      grid-template-columns: auto auto;
    }
  }
</style>
