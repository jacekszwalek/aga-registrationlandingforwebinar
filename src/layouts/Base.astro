---
import { eventConfig } from '../config/event.config';
import { parseSessions, getEventStatus } from '../lib/eventState';
import { withBase } from '../lib/paths';
import headingFont from '../assets/fonts/ltflodeneue-medium.woff2?url';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  path?: string;
  /** Tytuł do podglądu linku (krótszy niż <title>); domyślnie = title. */
  ogTitle?: string;
  /** Opis do podglądu linku; domyślnie = description. */
  ogDescription?: string;
  /** Ścieżka, na którą ma prowadzić udostępniony link (np. strona podziękowania → strona zapisu). */
  ogPath?: string;
}

const { title, description, noindex = false, path = '/', ogTitle = title, ogDescription = description, ogPath = path } = Astro.props;
const sessions = parseSessions(eventConfig.sessions);
// Stan liczony przy budowaniu (fallback bez JS); skrypt niżej koryguje go w przeglądarce.
const buildState = getEventStatus(Date.now(), sessions).state;
const sessionsMs = sessions.map((s) => [s.start, s.end]);
const variant = eventConfig.headlineVariant;
const allowPreview = eventConfig.allowPreviewParams;
const canonical = new URL(withBase(path), Astro.site ?? eventConfig.site.url).toString();
const ogUrl = new URL(withBase(ogPath), Astro.site ?? eventConfig.site.url).toString();
// Archiwum wersji (/archived/…) nigdy nie trafia do wyszukiwarek – dostępne tylko z adresu.
// Absolutny URL z domeny produkcyjnej – Facebook/LinkedIn pobierają obraz zawsze z subdomeny.
const ogImage = `${eventConfig.site.url.replace(/\/$/, '')}/og-image.png`;
const siteRoot = eventConfig.site.url.replace(/\/$/, '');
const ogLogo = `${siteRoot}/logo.png`;
// Schema.org Organization – standardowy sposób przekazania logo (Google); og:logo to tag niestandardowy.
const orgJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: eventConfig.controller.brand,
  url: 'https://przystanzmianyzawodowej.pl/',
  logo: ogLogo,
});
const ogImageAlt = 'Bezpłatny webinar „Zostać, zmienić pracę czy pójść własną drogą?” – 3 grudnia 2026, 19:00, online, 90 min. Przystań Zmiany Zawodowej.';
const robotsNoindex = noindex || !eventConfig.site.indexable || path.startsWith('archived/');
---

<!doctype html>
<html lang="pl" data-state={buildState} data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robotsNoindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Przystań Zmiany Zawodowej" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <!-- Obraz podglądu linku (Facebook, LinkedIn, Messenger) – public/og-image.png, generator: scripts/og-image.mjs -->
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <!-- og:logo – niestandardowy (poza specyfikacją ogp.me); Facebook/LinkedIn go pomijają, część narzędzi go czyta. -->
    <meta property="og:logo" content={ogLogo} />
    <script type="application/ld+json" set:html={orgJsonLd} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("favicon-32.png")} />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />

    <script is:inline define:vars={{ sessionsMs, variant, allowPreview }}>
      (function () {
        var d = document.documentElement;
        var now = Date.now();
        var state = 'after';
        for (var i = 0; i < sessionsMs.length; i++) {
          if (now >= sessionsMs[i][0] && now < sessionsMs[i][1]) { state = 'during'; break; }
        }
        if (state === 'after') {
          for (var j = 0; j < sessionsMs.length; j++) {
            if (now < sessionsMs[j][0]) { state = 'before'; break; }
          }
        }
        var v = variant;
        if (allowPreview) {
          var q = new URLSearchParams(location.search);
          var ps = q.get('state');
          if (ps === 'before' || ps === 'during' || ps === 'after') state = ps;
          var pv = (q.get('v') || '').toUpperCase();
          if (pv === 'A' || pv === 'B') v = pv;
        }
        d.dataset.state = state;
        d.dataset.variant = v;
        window.__pzzSessions = sessionsMs;

        // Google Consent Mode v2 – domyślnie odmowa. Żaden skrypt zewnętrzny nie jest tu ładowany.
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
          wait_for_update: 500
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
