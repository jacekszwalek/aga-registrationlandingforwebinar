{
  "name": "przystan-webinar-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview --port 4321",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test": "npm run test:unit && npm run test:e2e",
    "screenshots": "node scripts/screenshots.mjs",
    "serve": "node scripts/serve.mjs",
    "build:pages": "SITE_URL=https://jacekszwalek.github.io BASE_PATH=/aga-registrationlandingforwebinar npm run build",
    "build:release": "SITE_URL=https://webinar.przystanzmianyzawodowej.pl BASE_PATH=/ PUBLIC_RELEASE=1 npm run build && rm -rf dist/v1 dist/v2 dist/v3 dist/v4 dist/v5 dist/podglad && cp deploy/htaccess-root dist/.htaccess && cp deploy/htaccess-assets dist/_astro/.htaccess"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.4.11",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
