# Generator linków UTM – https://przystanzmianyzawodowej.pl/utmgen/ (public_html/utmgen na webd.pl)
# Narzędzie wewnętrzne: poza wyszukiwarkami, bez listowania katalogu. Własny RewriteEngine wyłącza tu reguły WordPressa.
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType font/woff2 .woff2
AddType text/javascript .js

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
