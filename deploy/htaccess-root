# https://przystanzmianyzawodowej.pl/webinar/ – statyczna strona (Astro), hosting webd.pl (Apache/LiteSpeed).
# Katalog public_html/webinar: podstrona domeny głównej (WordPress w public_html) i zarazem document root
# subdomeny webinar.przystanzmianyzawodowej.pl. Własny RewriteEngine wyłącza tu reguły WordPressa.
DirectoryIndex index.html index.php
Options -Indexes

# Wymuszenie HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Stara subdomena → podstrona domeny głównej (ważny certyfikat). Zastępuje przekierowanie z cPanelu,
  # które i tak trafiłoby do tego pliku i byłoby nadpisywane przy każdym wdrożeniu.
  RewriteCond %{HTTP_HOST} ^webinar\.przystanzmianyzawodowej\.pl$ [NC]
  RewriteRule ^(.*)$ https://przystanzmianyzawodowej.pl/webinar/$1 [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Krótkie linki: /webinar/…/l/kod → l/index.php (docs/skracacz.md). „.” w kodzie niedozwolona, więc l/index.php nie pętli.
  RewriteRule ^(.*/)?l/([A-Za-z0-9-]+)/?$ l/index.php?c=$2&p=/webinar/$1 [L]
</IfModule>

AddType text/calendar .ics
AddType font/woff2 .woff2
AddType image/avif .avif
AddType image/webp .webp

# Kompresja
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript text/calendar image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # HTML zawsze świeży (zmiany widać od razu po wdrożeniu)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Pliki stanu wdrożenia FTP nie są publiczne
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
